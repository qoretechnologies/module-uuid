set(manifest "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
if(NOT EXISTS "${manifest}")
    message(FATAL_ERROR "Cannot find install manifest: ${manifest}")
endif()
set(stage "$ENV{DESTDIR}")
if(NOT "${stage}" STREQUAL "" AND NOT IS_ABSOLUTE "${stage}")
    message(FATAL_ERROR "DESTDIR must be absolute: ${stage}")
endif()
if(NOT "${stage}" STREQUAL "")
    get_filename_component(stage_real "${stage}" REALPATH)
endif()
file(STRINGS "${manifest}" entries)
set(targets)
# Complete validation before changing any file; the manifest may contain spaces
# and symlinks, but must not name directories or escape a staged installation.
foreach(entry IN LISTS entries)
    if(NOT IS_ABSOLUTE "${entry}" OR "${entry}" MATCHES "(^|/)\\.\\.(/|$)")
        message(FATAL_ERROR "Invalid install path: ${entry}")
    endif()
    set(target "${stage}${entry}")
    if(NOT "${stage}" STREQUAL "")
        # Resolve parents, but never follow the file being unlinked itself.
        get_filename_component(parent "${target}" DIRECTORY)
        get_filename_component(parent_real "${parent}" REALPATH)
        file(RELATIVE_PATH within_stage "${stage_real}" "${parent_real}")
        if(IS_ABSOLUTE "${within_stage}" OR "${within_stage}" MATCHES "^\\.\\.(/|$)")
            message(FATAL_ERROR "Install path escapes DESTDIR: ${target}")
        endif()
    endif()
    if(IS_DIRECTORY "${target}" AND NOT IS_SYMLINK "${target}")
        message(FATAL_ERROR "Refusing directory in install manifest: ${target}")
    endif()
    list(APPEND targets "${target}")
endforeach()
foreach(target IN LISTS targets)
    file(REMOVE "${target}")
    if(EXISTS "${target}" OR IS_SYMLINK "${target}")
        message(FATAL_ERROR "Cannot remove installed file: ${target}")
    endif()
endforeach()
